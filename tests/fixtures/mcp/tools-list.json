[
  {
    "description": "Get the task that should be worked on now.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "name": "get_focus"
  },
  {
    "description": "Get one task by UUID.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "description": "A valid UUID string.",
          "examples": [
            "80d7db87-324e-4e8d-a5b7-ff78cd5bf39a"
          ],
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "type": "object"
    },
    "name": "get_task"
  },
  {
    "description": "List tasks filtered by period, status, and category.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "anyOf": [
              {
                "enum": [
                  "earning",
                  "sustaining",
                  "recovery",
                  "investment",
                  "consumption"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "period": {
          "additionalProperties": false,
          "properties": {
            "field": {
              "enum": [
                "scheduled_start",
                "created_at",
                "deadline",
                "completed_at"
              ],
              "type": "string"
            },
            "from": {
              "description": "An RFC 3339 date-time string with a UTC offset.",
              "examples": [
                "2026-08-29T10:00:00+09:00"
              ],
              "format": "date-time",
              "type": "string"
            },
            "until": {
              "description": "An RFC 3339 date-time string with a UTC offset.",
              "examples": [
                "2026-08-29T10:00:00+09:00"
              ],
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "field",
            "from",
            "until"
          ],
          "type": "object"
        },
        "statuses": {
          "items": {
            "enum": [
              "todo",
              "pending",
              "done"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "name": "list_tasks"
  },
  {
    "description": "Get Schronu's calculated task schedule for a date range.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "A calendar date in YYYY-MM-DD format without a time or time zone.",
          "examples": [
            "2026-08-29"
          ],
          "format": "date",
          "type": "string"
        },
        "until": {
          "description": "A calendar date in YYYY-MM-DD format without a time or time zone.",
          "examples": [
            "2026-08-29"
          ],
          "format": "date",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "name": "get_schedule"
  },
  {
    "description": "Create a new root project task.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "estimated_work_minutes": {
          "description": "A non-negative integer.",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "A non-empty string.",
          "minLength": 1,
          "type": "string"
        },
        "pending_until": {
          "description": "An RFC 3339 date-time string with a UTC offset.",
          "examples": [
            "2026-08-29T10:00:00+09:00"
          ],
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "create_task"
  },
  {
    "description": "Add child tasks to an existing task.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "names": {
          "items": {
            "description": "A non-empty string.",
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "parent_id": {
          "description": "A valid UUID string.",
          "examples": [
            "80d7db87-324e-4e8d-a5b7-ff78cd5bf39a"
          ],
          "format": "uuid",
          "type": "string"
        },
        "pending_until": {
          "description": "An RFC 3339 date-time string with a UTC offset.",
          "examples": [
            "2026-08-29T10:00:00+09:00"
          ],
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "parent_id",
        "names"
      ],
      "type": "object"
    },
    "name": "breakdown_task"
  },
  {
    "description": "Defer a task until an absolute date and time.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "pending_until": {
          "description": "An RFC 3339 date-time string with a UTC offset.",
          "examples": [
            "2026-08-29T10:00:00+09:00"
          ],
          "format": "date-time",
          "type": "string"
        },
        "task_id": {
          "description": "A valid UUID string.",
          "examples": [
            "80d7db87-324e-4e8d-a5b7-ff78cd5bf39a"
          ],
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "pending_until"
      ],
      "type": "object"
    },
    "name": "defer_task"
  },
  {
    "description": "Defer a routine task to its next repetition cycle.",
