      "additionalProperties": false,
      "properties": {
        "task_id": {
          "description": "A valid UUID string.",
          "examples": [
            "80d7db87-324e-4e8d-a5b7-ff78cd5bf39a"
          ],
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "type": "object"
    },
    "name": "defer_routine_task"
  },
  {
    "description": "Complete a task, optionally recording finish time and work seconds.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "additional_actual_work_seconds": {
          "default": 0,
